# =============================================================================
# consul — Environment Variables
# =============================================================================
# Local: `.env` is generated with `make env` from Vault (secret/consul/dev).
# Do not edit it manually. Only CONSUL_GOSSIP_KEY is secret.
# Production: provision this file with Ansible / AWS Secrets Manager.
# =============================================================================

# ── Project ─────────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Consul ──────────────────────────────────────────────────────────────────
# Generated with `consul keygen` and stored in Vault (secret/consul/dev).
CONSUL_GOSSIP_KEY=
CONSUL_HOST=127.0.0.1
CONSUL_API_PORT=8500
CONSUL_DNS_PORT=8600
CONSUL_DATACENTER=dev
